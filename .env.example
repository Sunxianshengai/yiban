# 对话（家伴 / 换个人说说话）必须接模型才有回话——没有本地模板兜底。
# 最省事的做法：只填下面一行，接口地址和模型名会自动用 DeepSeek 的默认值。
# 申请地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# 也可以换成阿里云百炼（同一把 key 也用于声音克隆）：
# DASHSCOPE_API_KEY=

# 两家都填时用 AI_PROVIDER 指定用谁：deepseek / dashscope
AI_PROVIDER=

# 想接别的服务（任何兼容 Chat Completions 的接口）时，把下面三项填全即可，
# 填齐后会覆盖上面的预设。例如：https://你的服务商域名/v1/chat/completions
AI_API_URL=
AI_API_KEY=
AI_MODEL=

# Vercel 上连接 Neon 和私有 Blob 后，由集成注入以下变量。
# 本机开发留空时使用本地 SQLite 和本机上传目录。
DATABASE_URL=
BLOB_STORE_ID=
BLOB_WEBHOOK_PUBLIC_KEY=
# Blob 使用 Vercel 运行时 OIDC 身份；本地连接云端时先运行 vercel env pull。
# 旧版读写令牌可用于服务端读写，但浏览器上传仍需要 webhook 公钥。
# BLOB_READ_WRITE_TOKEN=

# 阿里云百炼（DashScope）声音克隆 + 合成（CosyVoice-v3-Flash）。
# 克隆免费，合成约 1 元 / 万字符。配置后页面「我的家人」会出现「复刻我的声音」。
# 申请地址：https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=
# 声音复刻接口所在工作空间的专属域名前缀（华北2-北京）。若使用其他区域工作空间请相应修改。
# 留空则默认使用 cn-beijing.maas.aliyuncs.com
DASHSCOPE_WORKSPACE_ID=

# 陪伴聊天专用识别/合成；不改变家庭记忆的模型配置。
# 配置 DASHSCOPE_API_KEY 后可用；工作空间/区域需与 key 一致。
# DASHSCOPE_BASE_URL=https://你的工作空间.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# 可选覆盖，URL 为完整端点。KEY 留空时复用 DASHSCOPE_API_KEY。
# YIBAN_ASR_URL=
# YIBAN_ASR_KEY=
YIBAN_ASR_MODEL=qwen3-asr-flash
# YIBAN_VISION_URL=
# YIBAN_VISION_KEY=
YIBAN_VISION_MODEL=qwen3-vl-flash
# YIBAN_TTS_URL=
# YIBAN_TTS_KEY=
# 留空按所选音色自动使用 v2 或 v3-flash，避免音色与模型不匹配。
YIBAN_TTS_MODEL=

# AI 伴侣专属克隆音色：千问 AI 平台（与以上百炼家人配置独立）。
QWEN_VOICE_API_KEY=
QWEN_VOICE_MODEL=qwen-audio-3.1-tts-plus
# QWEN_VOICE_BASE_URL=https://maas.qianwenaiapi.com/api/v1
# 已有音色可按账号登记，不重复上传。格式见 docs/companion-voice.md。
# QWEN_COMPANION_VOICES_JSON=

# 非正式环境必须使用独立数据库，并与数据库内的环境绑定一致。
# YIBAN_DATABASE_ENVIRONMENT=preview
# 本机/自动化验收推荐 npm run test:server，无需云端凭据。
# YIBAN_DATA_ENV=test
# 首次初始化正式站的平台管理员需要一次性设置口令。
# YIBAN_SETUP_TOKEN=

