{
  "name": "journey-replica-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "desktop": "node electron/launch.cjs",
    "desktop:dev": "node electron/launch.cjs --dev --no-main",
    "desktop:build:win": "electron-builder --win",
    "desktop:build:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "cc.eu.memory.yiban",
    "productName": "忆伴",
    "asar": false,
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "!node_modules/**"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/app-icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "${productName}",
      "artifactName": "${productName}-Windows-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "electron/app-icon.png",
      "category": "public.app-category.lifestyle",
      "artifactName": "${productName}-macOS-${arch}-${version}.${ext}"
    }
  },
  "dependencies": {
    "@breezystack/lamejs": "1.2.7",
    "@mdi/js": "^7.4.47",
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/blob": "^2.9.0",
    "dexie": "^4.2.1",
    "docx": "9.15.3",
    "dompurify": "3.4.17",
    "exifr": "7.1.3",
    "fflate": "^0.8.3",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^4.7.1",
    "nuxt": "^4.2.2",
    "three": "0.180.0",
    "vue": "^3.5.24",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/three": "0.180.0",
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0"
  }
}
