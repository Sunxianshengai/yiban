{
  "name": "yiban-memory",
  "version": "1.0.0",
  "private": true,
  "description": "忆伴 · 新生杯家庭记忆交互应用",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "electron": "electron .",
    "desktop:pack": "electron-builder --win nsis",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/blob": "^2.8.2",
    "next": "16.4.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.yiban.memory",
    "productName": "忆伴",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
