      "html": "<button class=\"ds-btn-primary\">保存待确认</button>",
      "css": ".ds-btn-primary{font-family:var(--font-sans,'Noto Sans SC',sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:0 20px;min-height:44px;border-radius:var(--radius-sm,10px);font-size:1rem;font-weight:500;white-space:nowrap;border:1px solid transparent;cursor:pointer;transition:background .16s,border-color .16s,color .16s;background:var(--brand,#2E5147);color:var(--on-brand,#FFFDF9);border-color:var(--brand,#2E5147);}.ds-btn-primary:hover:not(:disabled){background:var(--brand-strong,#24403A);border-color:var(--brand-strong,#24403A);}.ds-btn-primary:focus-visible{outline:2.5px solid var(--brand,#2E5147);outline-offset:2px;}.ds-btn-primary:disabled{opacity:.45;cursor:not-allowed;}",
