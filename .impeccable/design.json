    {
      "name": "Memory Field",
      "kind": "input",
      "description": "Label, editable field and persistent hint.",
      "html": "<label class=\"ds-field\"><span>记忆名称</span><input placeholder=\"给这段回忆起个名字（选填）\"/><small>可以留空，我们会用第一句话作为标题。</small></label>",
      "css": ".ds-field{font-family:var(--font-sans,'Noto Sans SC',sans-serif);display:flex;flex-direction:column;gap:7px;color:var(--ink,#25332D)}.ds-field>span{font-size:.9688rem;font-weight:500}.ds-field>small{font-size:.8438rem;color:var(--muted,#687168);line-height:1.7}.ds-field input{font-family:var(--font-sans,'Noto Sans SC',sans-serif);color:var(--ink,#25332D);background:var(--surface,#FFFEFB);border:1px solid var(--border-strong,#BFC9BB);border-radius:var(--radius-sm,10px);padding:9px 14px;min-height:44px;font-size:1rem;transition:border-color .15s,box-shadow .15s}.ds-field input:focus{border-color:var(--brand,#2E5147);box-shadow:0 0 0 3px color-mix(in srgb,var(--brand,#2E5147) 16%,transparent)}.ds-field input:focus-visible{outline:2.5px solid var(--brand,#2E5147);outline-offset:2px;}",
      "refersTo": "field"
    },
    {
      "name": "Current Navigation",
      "kind": "nav",
      "description": "Text-led active navigation treatment; mobile layout is documented separately.",
      "html": "<nav class=\"ds-nav\"><button aria-current=\"page\">首页</button><button>记忆库</button></nav>",
      "css": ".ds-nav{display:grid;gap:2px}.ds-nav button{font-family:var(--font-sans,'Noto Sans SC',sans-serif);text-align:left;min-height:44px;padding:9px 11px;border-radius:var(--radius-sm,10px);color:var(--ink-2,#3D4A43);font-size:1rem;background:transparent;border:0;cursor:pointer}.ds-nav button:hover{background:var(--canvas,#F7F6F2);color:var(--ink,#25332D)}.ds-nav button[aria-current]{background:var(--brand-soft,#E9F0E9);color:var(--brand,#2E5147);font-weight:600}.ds-nav button:focus-visible{outline:2.5px solid var(--brand,#2E5147);outline-offset:2px;}",
