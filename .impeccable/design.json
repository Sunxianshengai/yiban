    {
      "name": "Memory Card",
      "kind": "card",
      "description": "Representative card excerpt with an inline SVG placeholder; actual cards carry provenance, metadata and independent actions.",
      "html": "<article class=\"ds-memory\"><button class=\"ds-memory-cover\" aria-label=\"查看一段家庭故事\"><svg width=\"48\" height=\"48\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\"/><circle cx=\"8.5\" cy=\"8.5\" r=\"1.5\"/><path d=\"m21 15-5-5L5 21\"/></svg></button><div class=\"ds-memory-body\"><small>家人</small><button class=\"ds-memory-title\">一段家庭故事</button><p>地点待补充</p></div></article>",
      "css": ".ds-memory{font-family:var(--font-sans,'Noto Sans SC',sans-serif);max-width:280px;overflow:hidden;background:var(--surface,#FFFEFB);border:1px solid var(--border,#D9DED3);border-radius:var(--radius,12px);color:var(--ink,#25332D);transition:transform .18s ease-out}.ds-memory:hover{border-color:var(--border-strong,#BFC9BB);transform:translateY(-2px)}.ds-memory-cover{display:grid;place-items:center;width:100%;aspect-ratio:3/2;border:0;background:var(--leaf,#E8EEE4);color:var(--brand,#2E5147);cursor:pointer}.ds-memory-body{padding:14px 16px 13px}.ds-memory-body small,.ds-memory-body p{color:var(--muted,#687168);font-size:.8125rem}.ds-memory-title{font-family:var(--font-sans,'Noto Sans SC',sans-serif);display:block;border:0;background:transparent;color:inherit;font-size:1.125rem;line-height:1.5;font-weight:600;text-align:left;padding:0;cursor:pointer}.ds-memory button:focus-visible{outline:2.5px solid var(--brand,#2E5147);outline-offset:2px;}@media(prefers-reduced-motion:reduce){.ds-memory{transition:none}.ds-memory:hover{transform:none}}",
      "refersTo": "memory-card"
    },
    {
      "name": "Story Player",
      "kind": "custom",
      "description": "Source label and native audio controls. Preview has no media attachment; actual player uses the saved family recording.",
      "html": "<section class=\"ds-story\"><strong>听听家人的原声</strong><small>真实录音 · 已有内容回放不消耗积分</small><audio controls aria-label=\"家人原声\"></audio></section>",
      "css": ".ds-story{font-family:var(--font-sans,'Noto Sans SC',sans-serif);display:flex;flex-wrap:wrap;gap:14px;padding:20px;background:var(--leaf,#E8EEE4);border-radius:12px;color:var(--ink,#25332D)}.ds-story strong{font-size:1rem}.ds-story small{display:block;color:var(--muted,#687168);font-size:.72rem;line-height:1.7}.ds-story audio{width:100%}.ds-story audio:focus-visible{outline:2.5px solid var(--brand,#2E5147);outline-offset:2px;}@media(max-width:640px){.ds-story{padding:16px}}",
      "refersTo": "story-player"
