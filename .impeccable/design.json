      "css": ".ds-btn-danger{font-family:var(--font-sans,'Noto Sans SC',sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:0 20px;min-height:44px;border-radius:var(--radius-sm,10px);font-size:1rem;font-weight:500;white-space:nowrap;border:1px solid transparent;cursor:pointer;transition:background .16s,border-color .16s,color .16s;background:var(--surface,#FFFEFB);color:var(--error,#A23F32);border-color:color-mix(in srgb,var(--error,#A23F32) 38%,transparent);}.ds-btn-danger:hover:not(:disabled){background:var(--error-soft,#F6E7E3);}.ds-btn-danger:focus-visible{outline:2.5px solid var(--brand,#2E5147);outline-offset:2px;}.ds-btn-danger:disabled{opacity:.45;cursor:not-allowed;}"
